        <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
            
            <!-- Mobile Menu Toggle Button -->
            <button onclick="toggleMobileNav()" class="md:hidden text-ink p-2 focus:outline-none" aria-label="Apri Menu">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"></path>
                </svg>
            </button>

            <!-- Navigation Links (Desktop) -->
            <nav class="hidden md:flex space-x-8 text-[11px] uppercase tracking-[0.25em] text-stoneGray">
                <a href="#catalogo" onclick="setCategoryFilter('Tutti')" class="hover:text-ink transition-colors">Collezione</a>
                <a href="#chisiamo" class="hover:text-ink transition-colors">Chi Siamo</a>
                <a href="#filosofia" class="hover:text-ink transition-colors">Filosofia</a>
                <a href="#contatti" class="hover:text-ink transition-colors">Contatti</a>
            </nav>

            <!-- Brand Logo -->
            <a href="#" class="font-serif text-2xl sm:text-3xl tracking-[0.3em] uppercase font-light text-center">
                ATELIER ESSENTIEL
            </a>

            <!-- Cart Trigger Button -->
            <button onclick="toggleCartDrawer()" class="flex items-center space-x-2 text-[11px] uppercase tracking-[0.2em] hover:text-stoneGray transition-colors">
                <span class="hidden sm:inline">Carrello</span>
                <span id="cartCountBadge" class="w-5 h-5 rounded-full bg-ink text-paper flex items-center justify-center text-[10px] font-medium">0</span>
            </button>
        </div>

        <!-- Mobile Navigation Menu Dropdown -->
        <div id="mobileNavMenu" class="hidden md:hidden border-b border-lightBorder bg-paper px-6 py-4 space-y-3 text-[11px] uppercase tracking-[0.2em] text-stoneGray">
            <a href="#catalogo" onclick="setCategoryFilter('Tutti'); toggleMobileNav();" class="block hover:text-ink py-1">Collezione</a>
            <a href="#chisiamo" onclick="toggleMobileNav();" class="block hover:text-ink py-1">Chi Siamo</a>
            <a href="#filosofia" onclick="toggleMobileNav();" class="block hover:text-ink py-1">Filosofia</a>
            <a href="#contatti" onclick="toggleMobileNav();" class="block hover:text-ink py-1">Contatti</a>
        </div>
    </header>

    <!-- BANNER INTRODUTTIVO (HERO MINIMAL) -->
    <section class="py-20 sm:py-28 border-b border-lightBorder text-center px-6">
        <div class="max-w-3xl mx-auto space-y-6">
            <span class="text-[10px] uppercase tracking-[0.35em] text-stoneGray font-medium">Edizione Permanente · Milano</span>
            <h1 class="font-serif text-4xl sm:text-6xl font-light tracking-wide leading-tight">
                Forme Essenziali, <br><span class="italic font-normal">Fibre Nobili.</span>
            </h1>
            <p class="text-stoneGray text-xs sm:text-sm font-light leading-relaxed max-w-xl mx-auto tracking-wide">
                Una selezione rigorosa di capi realizzati in tiratura limitata. Nessuna ostentazione, solo proporzioni pure, cashmere Loro Piana e seta di Como.
            </p>
        </div>
    </section>

    <!-- CATALOGO SECTION -->
    <main id="catalogo" class="max-w-7xl mx-auto px-6 py-16 flex-1 w-full">
        
        <!-- BARRA FILTRI & RICERCA -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 pb-8 mb-12 border-b border-lightBorder">
            
            <!-- Category Tabs -->
            <div id="categoryTabs" class="flex flex-wrap gap-4 text-[11px] uppercase tracking-[0.2em]">
                <button onclick="setCategoryFilter('Tutti')" class="cat-tab pb-1 border-b border-ink font-medium text-ink">Tutti</button>
                <button onclick="setCategoryFilter('Cappotti')" class="cat-tab pb-1 border-b border-transparent text-stoneGray hover:text-ink">Cappotti</button>
                <button onclick="setCategoryFilter('Maglieria')" class="cat-tab pb-1 border-b border-transparent text-stoneGray hover:text-ink">Maglieria</button>
                <button onclick="setCategoryFilter('Abiti')" class="cat-tab pb-1 border-b border-transparent text-stoneGray hover:text-ink">Abiti</button>
                <button onclick="setCategoryFilter('Accessori')" class="cat-tab pb-1 border-b border-transparent text-stoneGray hover:text-ink">Accessori</button>
            </div>

            <!-- Search Input -->
            <div class="relative w-full md:w-64">
                <input type="text" id="searchInput" oninput="handleSearch()" placeholder="Cerca tessuto o capo..." 
                       class="w-full bg-transparent border-b border-lightBorder pb-1 text-xs text-ink placeholder-stoneGray focus:outline-none focus:border-ink transition-colors tracking-wider">
            </div>
        </div>

        <!-- PRODUCT GRID -->
        <div id="productGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
            <!-- Rendered by JavaScript -->
        </div>

        <!-- Empty State -->
        <div id="emptyState" class="hidden text-center py-20 border border-dashed border-lightBorder my-8">
            <p class="font-serif text-xl text-stoneGray">Nessun capo trovato</p>
            <button onclick="resetFilters()" class="mt-4 text-[10px] uppercase tracking-[0.2em] underline text-ink">Mostra tutti i capi</button>
        </div>
    </main>

    <!-- SEZIONE CHI SIAMO -->
    <section id="chisiamo" class="border-t border-lightBorder py-24 bg-paper">
        <div class="max-w-6xl mx-auto px-6">
            <div class="text-center max-w-2xl mx-auto mb-16 space-y-3">
                <span class="text-[10px] uppercase tracking-[0.35em] text-stoneGray font-medium">La Nostra Casa</span>
                <h2 class="font-serif text-3xl sm:text-5xl font-light">L’Eredità dell’Essenziale</h2>
                <div class="w-12 h-px bg-ink mx-auto mt-4"></div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
                <!-- Text Content -->
                <div class="space-y-6 text-xs sm:text-sm text-stoneGray leading-relaxed font-light">
                    <p class="text-ink font-serif text-xl sm:text-2xl leading-snug">
                        Nata nel cuore sartoriale di Milano, Atelier Essentiel ridefinisce il concetto di lusso attraverso la discrezione e il rigore materico.
                    </p>
                    <p>
                        Fondata nel 2018, la nostra Maison è nata come risposta all'iper-produzione contemporanea. Scegliamo di non seguire le stagioni né le tendenze passeggera, focalizzandoci esclusivamente su capi iconici senza tempo.
                    </p>
                    <p>
                        Ogni modello viene studiato per mesi, perfezionando la caduta del tessuto e le cuciture a mano, avvalendoci della collaborazione con storiche tessiture piemontesi e sarti artigiani che tramandano il mestiere da generazioni.
                    </p>
                </div>

                <!-- Stats & Key Values -->
                <div class="grid grid-cols-2 gap-6 p-8 border border-lightBorder bg-white">
                    <div class="space-y-2 border-r border-b border-lightBorder pb-6 pr-4">
                        <span class="font-serif text-3xl sm:text-4xl font-light text-ink">100%</span>
                        <p class="text-[10px] uppercase tracking-[0.2em] text-stoneGray">Sartorialità Italiana</p>
                    </div>
                    <div class="space-y-2 border-b border-lightBorder pb-6 pl-2">
                        <span class="font-serif text-3xl sm:text-4xl font-light text-ink">0%</span>
                        <p class="text-[10px] uppercase tracking-[0.2em] text-stoneGray">Materiali Sintetici</p>
                    </div>
                    <div class="space-y-2 border-r border-lightBorder pt-4 pr-4">
                        <span class="font-serif text-3xl sm:text-4xl font-light text-ink">300</span>
                        <p class="text-[10px] uppercase tracking-[0.2em] text-stoneGray">Capi per Edizione</p>
                    </div>
                    <div class="space-y-2 pt-4 pl-2">
                        <span class="font-serif text-3xl sm:text-4xl font-light text-ink">100 Yrs</span>
                        <p class="text-[10px] uppercase tracking-[0.2em] text-stoneGray">Eredità dei Filati</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- SEZIONE FILOSOFIA -->
    <section id="filosofia" class="border-t border-lightBorder py-20 bg-paper">
        <div class="max-w-4xl mx-auto px-6 text-center space-y-4">
            <span class="text-[10px] uppercase tracking-[0.3em] text-stoneGray">Il Manifesto</span>
            <h2 class="font-serif text-3xl font-light">Sostenibilità del Tempo</h2>
            <p class="text-xs sm:text-sm text-stoneGray leading-relaxed font-light max-w-2xl mx-auto">
                Rifiutiamo i ritmi della moda stagionale. Creiamo capi pensati per rimanere immutati nel guardaroba per decenni, lavorati esclusivamente da storici laboratori artigianali italiani.
            </p>
        </div>
    </section>

    <!-- SEZIONE CONTATTI & BOUTIQUE -->
    <section id="contatti" class="border-t border-lightBorder py-24 bg-[#f8f7f3]">
        <div class="max-w-6xl mx-auto px-6">
            
            <div class="text-center max-w-2xl mx-auto mb-16 space-y-3">
                <span class="text-[10px] uppercase tracking-[0.35em] text-stoneGray font-medium">Relazioni Privé</span>
                <h2 class="font-serif text-3xl sm:text-4xl font-light">Contatta l’Atelier</h2>
                <p class="text-xs text-stoneGray font-light tracking-wide">
                    Il nostro team di concierge è a completa disposizione per consulenze d'immagine su misura o per prenotare un appuntamento privato in boutique.
                </p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
                
                <!-- Info Atelier & Boutique -->
