                            Domenica: Su appuntamento
                        </p>
                    </div>

                    <div>
                        <h3 class="font-serif text-xl font-normal text-ink mb-2">Direct Contacts</h3>
                        <p class="text-xs text-stoneGray leading-relaxed font-light">
                            Email: <a href="mailto:concierge@atelier-essentiel.com" class="text-ink underline">concierge@atelier-essentiel.com</a><br>
                            Tel: +39 02 8901 2345
                        </p>
                    </div>
                </div>

                <!-- Form Contattaci -->
                <div class="lg:col-span-7">
                    <form id="contactForm" onsubmit="handleContactSubmit(event)" class="space-y-6">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                            <div class="space-y-2">
                                <label for="firstName" class="text-[10px] uppercase tracking-[0.2em] text-ink font-medium block">Nome *</label>
                                <input type="text" id="firstName" required class="form-field" placeholder="Eugenio">
                            </div>
                            <div class="space-y-2">
                                <label for="lastName" class="text-[10px] uppercase tracking-[0.2em] text-ink font-medium block">Cognome *</label>
                                <input type="text" id="lastName" required class="form-field" placeholder="Di Savoia">
                            </div>
                        </div>

                        <div class="space-y-2">
                            <label for="email" class="text-[10px] uppercase tracking-[0.2em] text-ink font-medium block">Email *</label>
                            <input type="email" id="email" required class="form-field" placeholder="eugenio@maison.com">
                        </div>

                        <div class="space-y-2">
                            <label for="subject" class="text-[10px] uppercase tracking-[0.2em] text-ink font-medium block">Motivo della Richiesta</label>
                            <select id="subject" class="form-field">
                                <option value="Appuntamento in Boutique">Prenotazione Appuntamento in Boutique</option>
                                <option value="Informazioni Capi Su Misura">Informazioni Capi Su Misura</option>
                                <option value="Informativa Ordine">Assistenza su un Ordine</option>
                                <option value="Altro">Altra Richiesta</option>
                            </select>
                        </div>

                        <div class="space-y-2">
                            <label for="message" class="text-[10px] uppercase tracking-[0.2em] text-ink font-medium block">Messaggio *</label>
                            <textarea id="message" rows="4" required class="form-field resize-none" placeholder="Scrivi qui le tue richieste o la data preferita per la visita..."></textarea>
                        </div>

                        <button type="submit" class="w-full py-4 bg-ink text-paper text-xs uppercase tracking-[0.25em] hover:bg-goldAccent transition-colors duration-300">
                            Invia Messaggio Privato
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- FOOTER MINIMALE -->
    <footer class="border-t border-lightBorder py-12 text-center text-stoneGray text-[10px] uppercase tracking-[0.25em] space-y-4 bg-paper">
        <div>ATELIER ESSENTIEL · VIA MONTENAPOLEONE 12, MILANO</div>
        <div class="text-[9px] text-stoneGray/70">&copy; 2026 ATELIER ESSENTIEL. TUTTI I DIRITTI RISERVATI.</div>
    </footer>


    <!-- ================= DRAWERS & MODALS ================= -->

    <!-- CARRELLO DRAWER (SIDEBAR) -->
    <div id="cartDrawer" class="fixed inset-0 z-50 pointer-events-none hidden">
        <div id="cartBackdrop" onclick="toggleCartDrawer()" class="absolute inset-0 bg-ink/40 backdrop-blur-xs opacity-0 transition-opacity pointer-events-auto"></div>
        <div id="cartPanel" class="absolute top-0 right-0 bottom-0 w-full max-w-md bg-paper border-l border-lightBorder p-8 pointer-events-auto transform translate-x-full drawer-transition flex flex-col justify-between">
            
            <div>
                <div class="flex items-center justify-between pb-6 border-b border-lightBorder">
                    <h3 class="font-serif text-2xl font-light">La Tua Selezione</h3>
                    <button onclick="toggleCartDrawer()" class="text-stoneGray hover:text-ink text-xs uppercase tracking-widest">Chiudi ✕</button>
                </div>

                <div id="cartItemsList" class="divide-y divide-lightBorder my-6 max-h-[55vh] overflow-y-auto pr-2">
                    <!-- Dynamic cart items -->
                </div>
            </div>

            <div class="pt-6 border-t border-lightBorder space-y-4">
                <div class="flex justify-between items-center text-xs uppercase tracking-widest">
                    <span>Totale</span>
                    <span id="cartSubtotal" class="font-serif text-xl font-bold text-ink">€0</span>
                </div>
                <button onclick="handleCheckout()" class="w-full py-4 bg-ink text-paper text-xs uppercase tracking-[0.25em] hover:bg-stone-800 transition-colors">
                    Procedi all'Ordine Privé
                </button>
            </div>

        </div>
    </div>

    <!-- QUICK VIEW MODAL -->
    <div id="detailModal" class="fixed inset-0 z-50 bg-ink/50 backdrop-blur-xs flex items-center justify-center p-4 hidden">
        <div class="bg-paper border border-lightBorder max-w-xl w-full p-8 sm:p-10 relative">
            <button onclick="closeDetailModal()" class="absolute top-6 right-6 text-stoneGray hover:text-ink text-sm">✕</button>
            <div id="modalContent"></div>
        </div>
    </div>

    <!-- TOAST NOTIFICATION -->
    <div id="toast" class="fixed bottom-8 right-8 z-50 bg-ink text-paper text-[11px] uppercase tracking-widest px-6 py-3 border border-lightBorder shadow-xl transform translate-y-16 opacity-0 transition-all duration-300 pointer-events-none">
        Messaggio Inviato
    </div>


